/**
 * Register the native analysis types available in each Python script namespace.
 */
@When[os == "Linux"]
func analysisTypes(): Array<(String, PyObj)> {
    sourceTypes()
        .concat(bodyTypes())
        .concat(resultTypes())
        .concat(resolutionTypes())
        .concat(semanticTypes())
}

/**
 * Register project identities, source maps and macro expansion values.
 */
@When[os == "Linux"]
private func sourceTypes(): Array<(String, PyObj)> {
    [
        ("BinaryItem", BinaryItem.pyClass()),
        ("BinaryModel", BinaryModel.pyClass()),
        ("BinaryPackage", BinaryPackage.pyClass()),
        ("BinarySources", BinarySources.pyClass()),
        ("BodyMacroCall", BodyMacroCall.pyClass()),
        ("CangjieHome", CangjieHome.pyClass()),
        ("Cfg", Cfg.pyClass()),
        ("CfgOption", CfgOption.pyClass()),
        ("ExpandTo", ExpandTo.pyClass()),
        ("ExpandedFile", ExpandedFile.pyClass()),
        ("ExpandedOrigin", ExpandedOrigin.pyClass()),
        ("ExpandedPlace", ExpandedPlace.pyClass()),
        ("ExpandedSegment", ExpandedSegment.pyClass()),
        ("Expansion", Expansion.pyClass()),
        ("ExpansionOrigin", ExpansionOrigin.pyClass()),
        ("ImportError", ImportError.pyClass()),
        ("ImportItem", ImportItem.pyClass()),
        ("ImportPath", ImportPath.pyClass()),
        ("ImportSite", ImportSite.pyClass()),
        ("ImportTarget", ImportTarget.pyClass()),
        ("Imported", Imported.pyClass()),
        ("InactiveCode", InactiveCode.pyClass()),
        ("InactiveSourceFile", InactiveSourceFile.pyClass()),
        ("IndexedPackage", IndexedPackage.pyClass()),
        ("Item", Item.pyClass()),
        ("ItemFile", ItemFile.pyClass()),
        ("ItemId", ItemId.pyClass()),
        ("ItemKind", ItemKind.pyClass()),
        ("ItemTree", ItemTree.pyClass()),
        ("MacroDiagnostic", MacroDiagnostic.pyClass()),
        ("MacroItem", MacroItem.pyClass()),
        ("MacroItemValue", MacroItemValue.pyClass()),
        ("MacroSeverity", MacroSeverity.pyClass()),
        ("MappedSpan", MappedSpan.pyClass()),
        ("MappedText", MappedText.pyClass()),
        ("NoSpecific", NoSpecific.pyClass()),
        ("PackageItem", PackageItem.pyClass()),
        ("PackageModel", PackageModel.pyClass()),
        ("PackageRef", PackageRef.pyClass()),
        ("PackageRelation", PackageRelation.pyClass()),
        ("ScopeDiagnostic", ScopeDiagnostic.pyClass()),
        ("ScopeProblem", ScopeProblem.pyClass()),
        ("ScopeProblemAt", ScopeProblemAt.pyClass()),
        ("ScopeStage", ScopeStage.pyClass()),
        ("ShownExpansion", ShownExpansion.pyClass()),
        ("SpanOrigin", SpanOrigin.pyClass()),
        ("WhenDiagnostics", WhenDiagnostics.pyClass()),
