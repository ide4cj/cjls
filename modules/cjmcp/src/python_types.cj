@When[os == "Linux"]
import py_interop.PyObj

/**
 * Register the native analysis types available in each Python script namespace.
 */
@When[os == "Linux"]
func analysisTypes(): Array<(String, PyObj)> {
    sourceTypes().concat(bodyTypes()).concat(resultTypes()).concat(resolutionTypes())
}

/**
 * Register project identities, source maps and macro expansion values.
 */
@When[os == "Linux"]
private func sourceTypes(): Array<(String, PyObj)> {
    [
        ("BinaryItem", BinaryItem.pyClass()),
        ("BodyMacroCall", BodyMacroCall.pyClass()),
        ("Cfg", Cfg.pyClass()),
        ("CfgOption", CfgOption.pyClass()),
        ("ExpandTo", ExpandTo.pyClass()),
        ("ExpandedFile", ExpandedFile.pyClass()),
        ("ExpandedOrigin", ExpandedOrigin.pyClass()),
        ("ExpandedPlace", ExpandedPlace.pyClass()),
        ("ExpandedSegment", ExpandedSegment.pyClass()),
        ("Expansion", Expansion.pyClass()),
        ("ExpansionOrigin", ExpansionOrigin.pyClass()),
        ("ImportError", ImportError.pyClass()),
        ("ImportItem", ImportItem.pyClass()),
        ("ImportPath", ImportPath.pyClass()),
        ("ImportSite", ImportSite.pyClass()),
        ("ImportTarget", ImportTarget.pyClass()),
        ("Imported", Imported.pyClass()),
        ("InactiveCode", InactiveCode.pyClass()),
        ("IndexedPackage", IndexedPackage.pyClass()),
        ("Item", Item.pyClass()),
        ("ItemFile", ItemFile.pyClass()),
        ("ItemId", ItemId.pyClass()),
        ("ItemKind", ItemKind.pyClass()),
        ("ItemTree", ItemTree.pyClass()),
        ("MacroDiagnostic", MacroDiagnostic.pyClass()),
        ("MacroItem", MacroItem.pyClass()),
        ("MacroItemValue", MacroItemValue.pyClass()),
        ("MacroSeverity", MacroSeverity.pyClass()),
        ("MappedSpan", MappedSpan.pyClass()),
        ("MappedText", MappedText.pyClass()),
        ("NoSpecific", NoSpecific.pyClass()),
        ("PackageItem", PackageItem.pyClass()),
        ("PackageRef", PackageRef.pyClass()),
        ("PackageRelation", PackageRelation.pyClass()),
        ("ScopeDiagnostic", ScopeDiagnostic.pyClass()),
        ("ScopeProblem", ScopeProblem.pyClass()),
        ("ScopeProblemAt", ScopeProblemAt.pyClass()),
        ("ScopeStage", ScopeStage.pyClass()),
        ("ShownExpansion", ShownExpansion.pyClass()),
        ("SpanOrigin", SpanOrigin.pyClass()),
        ("WhenDiagnostics", WhenDiagnostics.pyClass()),
        ("WhenError", WhenError.pyClass())
    ]
}

/**
 * Register lowered bodies, signatures and their indexed values.
 */
@When[os == "Linux"]
private func bodyTypes(): Array<(String, PyObj)> {
    [
        ("AttrArg", AttrArg.pyClass()),
        ("Body", Body.pyClass()),
        ("BodyOrigin", BodyOrigin.pyClass()),
        ("BodyParam", BodyParam.pyClass()),
        ("BodyResolution", BodyResolution.pyClass()),
        ("BodySource", PythonBodySource.pyClass()),
        ("BodySourceMap", BodySourceMap.pyClass()),
        ("CallArg", CallArg.pyClass()),
        ("CatchArm", CatchArm.pyClass()),
        ("DeclAttr", DeclAttr.pyClass()),
        ("Expr", Expr.pyClass()),
        ("ExprId", ExprId.pyClass()),
        ("ExprScopes", ExprScopes.pyClass()),
        ("Generics", Generics.pyClass()),
        ("Local", Local.pyClass()),
        ("LocalFunc", LocalFunc.pyClass()),
        ("LocalId", LocalId.pyClass()),
        ("LocalKind", LocalKind.pyClass()),
        ("LoweredBody", LoweredBody.pyClass()),
        ("LoweredSignature", PythonLoweredSignature.pyClass()),
        ("MacroCall", MacroCall.pyClass()),
        ("MatchArm", MatchArm.pyClass()),
        ("Pat", Pat.pyClass()),
        ("PatId", PatId.pyClass()),
        ("Resource", BodyResource.pyClass()),
        ("ScopeData", ScopeData.pyClass()),
        ("ScopeId", ScopeId.pyClass()),
        ("Signature", Signature.pyClass()),
        ("SignatureSourceMap", PythonSignatureSourceMap.pyClass()),
        ("SignatureTypes", SignatureTypes.pyClass()),
        ("Stmt", Stmt.pyClass()),
        ("TyBound", TyBound.pyClass()),
        ("TypeBound", TypeBound.pyClass()),
        ("TypeRef", TypeRef.pyClass()),
        ("TypeRefId", TypeRefId.pyClass()),
        ("TypeSegment", TypeSegment.pyClass())
    ]
}

/**
 * Register analysis results returned by editor queries.
 */
@When[os == "Linux"]
private func resultTypes(): Array<(String, PyObj)> {
    [
        ("BuiltinDoc", BuiltinDoc.pyClass()),
        ("CompletionItem", CompletionItem.pyClass()),
        ("CompletionKind", CompletionKind.pyClass()),
        ("CompletionOverload", CompletionOverload.pyClass()),
        ("CompletionResult", CompletionResult.pyClass()),
        ("CompletionSource", CompletionSource.pyClass()),
        ("Definition", Definition.pyClass()),
        ("ExpandedMacro", ExpandedMacro.pyClass()),
        ("ExpansionKind", ExpansionKind.pyClass()),
        ("FileSymbol", FileSymbol.pyClass()),
        ("FormatOptions", FormatOptions.pyClass()),
        ("Fold", Fold.pyClass()),
        ("FoldKind", FoldKind.pyClass()),
        ("FoundSymbol", FoundSymbol.pyClass()),
        ("HighlightModifier", HighlightModifier.pyClass()),
        ("HighlightModifiers", HighlightModifiers.pyClass()),
        ("HighlightTag", HighlightTag.pyClass()),
        ("HighlightedRange", HighlightedRange.pyClass()),
        ("InferenceDiagnostic", InferenceDiagnostic.pyClass()),
        ("InferenceResult", InferenceResult.pyClass()),
        ("MacroCallAt", MacroCallAt.pyClass()),
        ("NavigationTarget", NavigationTarget.pyClass()),
        ("Reference", AnalysisReference.pyClass()),
        ("ReferenceAccess", ReferenceAccess.pyClass()),
        ("RelatedHighlight", RelatedHighlight.pyClass()),
        ("SimpleIf", SimpleIf.pyClass()),
        ("TextEdit", TextEdit.pyClass())
    ]
}

