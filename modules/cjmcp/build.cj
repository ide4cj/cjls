// Embed the checkout identity at compilation; querying Git at runtime would identify the analyzed project.
import std.env.getCommandLine
import std.fs.{File, exists}
import std.process.executeWithOutput

main(): Int64 {
    if (getCommandLine().get(1) != "pre-build") {
        return 0
    }
    let commit = git(["rev-parse", "--verify", "HEAD"])
    let status = git(["status", "--porcelain", "--untracked-files=normal"])
    let known = commit.isSome() && status.isSome()
    let identity = if (known) { (commit ?? "") } else { "" }
    let dirty = status.map { text => !text.isEmpty() } ?? false
    let text =
        "package cjmcp\n\n// Generated by modules/cjmcp/build.cj; do not edit.\n" +
            "let BUILD_COMMIT = \"${identity}\"\nlet BUILD_DIRTY = ${dirty}\n"
    let path = "src/build_info.cj"
    if (!exists(path) || String.fromUtf8(File.readFrom(path)) != text) {
        File.writeTo(path, text.toArray())
    }
    0
}

func git(args: Array<String>): ?String {
    try {
        let (code, out, _) = executeWithOutput("git", args)
        if (code == 0) { String.fromUtf8(out).trimAscii() } else { None }
    } catch (_: Exception) {
        None
    }
}
