class TyKind(_Partial):
    """Native variants support isinstance and match; payloads are field0, field1, etc.

ErrorTy is a user error; TodoTy is unsupported analysis; UnknownTy is missing
inputs or inference limits. They must not be treated as equivalent diagnoses.
Variant class attributes below refer to the private reference declarations.
"""
    PrimTy: ClassVar[type[_PrimTy]]
    DeclTy: ClassVar[type[_DeclTy]]
    ErrorTy: ClassVar[type[_ErrorTy]]
    TodoTy: ClassVar[type[_TodoTy]]
    UnknownTy: ClassVar[type[_UnknownTy]]


# These private names describe variant classes; they are not script globals.
class _PrimTy(TyKind):
    __match_args__: ClassVar[tuple[str, ...]] = ("field0",)
    def __init__(self, field0: str) -> None: ...
    @property
    def field0(self) -> str: ...


class _DeclTy(TyKind):
    __match_args__: ClassVar[tuple[str, ...]] = ("field0", "field1")
    def __init__(self, field0: DefId, field1: list[Ty]) -> None: ...
    @property
    def field0(self) -> DefId: ...
    @property
    def field1(self) -> list[Ty]: ...


class _ErrorTy(TyKind):
    def __init__(self) -> None: ...


class _TodoTy(TyKind):
    def __init__(self, field0: Todo) -> None: ...
    @property
    def field0(self) -> Todo: ...


class _UnknownTy(TyKind):
    def __init__(self, field0: UnknownReason) -> None: ...
    @property
    def field0(self) -> UnknownReason: ...


