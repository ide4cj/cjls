package syntax_codegen

import std.fs.{Directory, File, Path, exists}
import cjformat.{FormatOptions, formatText}
import cjformat.config.optionsFor

struct GeneratedFile {
    GeneratedFile(let path: Path, let contents: String) {}
}

struct Generated {
    Generated(let files: Array<GeneratedFile>, let model: Model) {}
}

/**
 * What the kinds file at `path` and its grammar make: the kinds and the typed views, where they belong, before
 * `cjformat` has had them.
 */
func generate(path: Path): Generated {
    let inputs = Inputs.load(path)
    let model = buildModel(inputs.kinds, inputs.grammar)
    let header =
        "// Generated by `syntax_codegen` from `${path.fileName}` and `${inputs.kinds.grammar}`: do not edit."
    Generated(
        [
            GeneratedFile(
                inputs.dir.join(inputs.kinds.kindsOutput),
                emitKinds(model, header, inputs.kinds.kindsPackage)
            ),
            GeneratedFile(
                inputs.dir.join(inputs.kinds.astOutput),
                emitAst(model, header, inputs.kinds.astPackage)
            )
        ],
        model
    )
}

/**
 * Writes `contents` to `path` as `cjformat` formats it: what is checked in is exactly what is generated.
 *
 * @throws IllegalStateException - if `cjformat` fails, which it does on code that does not parse
 */
func writeFormatted(path: Path, contents: String, options!: ?FormatOptions = None): Unit {
    let dir = path.parent
    if (!dir.isEmpty() && !exists(dir)) {
        Directory.create(dir, recursive: true)
    }
    let formatted =
        formatText(contents, options: options ?? optionsFor(path)) ??
            throw IllegalStateException("generated code does not parse: ${path}")
    File.writeTo(path, formatted.toArray())
}
