    public func toBytes(): Array<Byte> {
        let bytes = Array<Byte>(SIZE, repeat: 0)
        writeTo(bytes, 0)
        bytes
    }
}

/**
 * A `MsgContent` to write.
 */
public enum MsgContentData {
    | AsDefLib(DefLibData)
    | AsMultiCalls(MultiMacroCallsData)
    | AsMacroResult(MacroResultData)
    | AsExitTask(ExitTaskData)

    /**
     * Its type, as the field before its value holds it.
     */
    public prop tag: UInt8 {
        get() {
            match (this) {
                case AsDefLib(_) => 1
                case AsMultiCalls(_) => 2
                case AsMacroResult(_) => 3
                case AsExitTask(_) => 4
            }
        }
    }

    /**
     * Builds its value in `b`: where it is.
     */
    public func pack(b: FbBuilder): FbOffset {
        match (this) {
            case AsDefLib(v) => v.pack(b)
            case AsMultiCalls(v) => v.pack(b)
            case AsMacroResult(v) => v.pack(b)
            case AsExitTask(v) => b.createStruct(v.toBytes(), ExitTaskData.ALIGNMENT)
        }
    }
}

/**
 * A `MacroMsg` to write.
 */
public class MacroMsgData {
    public MacroMsgData(public let content!: ?MsgContentData = None) {}

    /**
     * Builds it in `b`, its children first: where it is.
     */
    public func pack(b: FbBuilder): FbOffset {
        let contentOffset = content.map { v => v.pack(b) }
        b.startTable()
        if (let (Some(v), Some(o)) <- (content, contentOffset)) {
            b.addUInt8(v.tag)
            b.slot(0)
            b.addOffset(o)
            b.slot(1)
        }
        b.endTable()
    }

    /**
     * The buffer of which it is the root.
     */
    public func toBytes(): Array<Byte> {
        let b = FbBuilder()
        b.finish(pack(b))
    }
}
