}

public struct Pattern {
    Pattern(let fb: FbTable) {}

    public prop kind: PatternKind {
        get() {
            PatternKind.fromValue(fb.scalar(0, 0, readInt8))
        }
    }

    public prop begin: ?Position {
        get() {
            fb.structAt(1).map {p => Position(fb.buf, p)}
        }
    }

    public prop end: ?Position {
        get() {
            fb.structAt(2).map {p => Position(fb.buf, p)}
        }
    }

    public prop patterns: FbVector<Pattern> {
        get() {
            fb.vector(3, 4, {b, p => Pattern(FbTable.at(b, p))})
        }
    }

    /**
     * SemaTy indexes.
     */
    public prop types: FbVector<UInt32> {
        get() {
            fb.vector(4, 4, readUInt32)
        }
    }

    public prop exprs: FbVector<UInt32> {
        get() {
            fb.vector(5, 4, readUInt32)
        }
    }

    public prop values: FbVector<ConstValue> {
        get() {
            ConstValue.readVector(fb, 6)
        }
    }

    public prop matchBeforeRuntime: Bool {
        get() {
            fb.scalar(8, false, readBool)
        }
    }

    public prop needRuntimeTypeCheck: Bool {
        get() {
            fb.scalar(9, false, readBool)
        }
    }
}

/**
 * For compatibility any new type kind MUST only be added at last.
 */
public enum TypeKind {
    /**
     * invalid
     */
    | Invalid
    /**
     * primitive type
     * unit
     */
    | `Unit`
    /**
     * integer
     */
    | `Int8`
    | `Int16`
    | `Int32`
    | `Int64`
    | `IntNative`
    /**
     * unsigned integer
     */
    | `UInt8`
    | `UInt16`
    | `UInt32`
    | `UInt64`
    | `UIntNative`
    /**
     * float
     */
    | `Float16`
    | `Float32`
    | `Float64`
    /**
     * char
     */
    | `Rune`
    | `Nothing`
    /**
     * bool
     */
    | `Bool`
    /**
     * composite type
     * Tuple
     */
    | Tuple
    /**
     * enum
     */
    | Enum
    /**
     * function
     */
    | Func
    /**
     * struct
     */
    | Struct
    /**
     * reference type
     * Array
     */
    | Array
    /**
     * VArray
     */
    | `VArray`
    | CPointer
    | CString
    | Class
    | Interface
    /**
     * typealias
     */
    | Type
    /**
     * genericTy
     */
    | Generic
    /**
     * A value this version of the schema does not have.
     */
    | Unknown(UInt16)
}

extend TypeKind <: Hashable & Equatable<TypeKind> & ToString {
    static func fromValue(value: UInt16): TypeKind {
        match (value) {
            case 0 => TypeKind.Invalid
            case 1 => TypeKind.`Unit`
            case 2 => TypeKind.`Int8`
            case 3 => TypeKind.`Int16`
            case 4 => TypeKind.`Int32`
            case 5 => TypeKind.`Int64`
            case 6 => TypeKind.`IntNative`
            case 7 => TypeKind.`UInt8`
            case 8 => TypeKind.`UInt16`
            case 9 => TypeKind.`UInt32`
            case 10 => TypeKind.`UInt64`
            case 11 => TypeKind.`UIntNative`
            case 12 => TypeKind.`Float16`
            case 13 => TypeKind.`Float32`
            case 14 => TypeKind.`Float64`
            case 15 => TypeKind.`Rune`
            case 16 => TypeKind.`Nothing`
            case 17 => TypeKind.`Bool`
            case 18 => TypeKind.Tuple
            case 19 => TypeKind.Enum
            case 20 => TypeKind.Func
            case 21 => TypeKind.Struct
            case 22 => TypeKind.Array
            case 23 => TypeKind.`VArray`
            case 24 => TypeKind.CPointer
            case 25 => TypeKind.CString
            case 26 => TypeKind.Class
            case 27 => TypeKind.Interface
            case 28 => TypeKind.Type
            case 29 => TypeKind.Generic
            case _ => TypeKind.Unknown(value)
        }
    }

    /**
     * Its value in the file.
     */
    public prop value: UInt16 {
        get() {
            match (this) {
                case TypeKind.Invalid => 0
                case TypeKind.`Unit` => 1
                case TypeKind.`Int8` => 2
                case TypeKind.`Int16` => 3
                case TypeKind.`Int32` => 4
                case TypeKind.`Int64` => 5
                case TypeKind.`IntNative` => 6
                case TypeKind.`UInt8` => 7
                case TypeKind.`UInt16` => 8
                case TypeKind.`UInt32` => 9
                case TypeKind.`UInt64` => 10
                case TypeKind.`UIntNative` => 11
                case TypeKind.`Float16` => 12
                case TypeKind.`Float32` => 13
                case TypeKind.`Float64` => 14
                case TypeKind.`Rune` => 15
                case TypeKind.`Nothing` => 16
                case TypeKind.`Bool` => 17
                case TypeKind.Tuple => 18
                case TypeKind.Enum => 19
                case TypeKind.Func => 20
                case TypeKind.Struct => 21
                case TypeKind.Array => 22
                case TypeKind.`VArray` => 23
                case TypeKind.CPointer => 24
                case TypeKind.CString => 25
                case TypeKind.Class => 26
                case TypeKind.Interface => 27
                case TypeKind.Type => 28
                case TypeKind.Generic => 29
                case TypeKind.Unknown(v) => v
            }
        }
    }

    public operator func ==(other: TypeKind): Bool {
        value == other.value
    }

    public operator func !=(other: TypeKind): Bool {
        value != other.value
    }

    public func hashCode(): Int64 {
        Int64(value)
    }

    public func toString(): String {
        match (this) {
            case TypeKind.Invalid => "Invalid"
            case TypeKind.`Unit` => "Unit"
            case TypeKind.`Int8` => "Int8"
            case TypeKind.`Int16` => "Int16"
            case TypeKind.`Int32` => "Int32"
            case TypeKind.`Int64` => "Int64"
            case TypeKind.`IntNative` => "IntNative"
            case TypeKind.`UInt8` => "UInt8"
            case TypeKind.`UInt16` => "UInt16"
            case TypeKind.`UInt32` => "UInt32"
            case TypeKind.`UInt64` => "UInt64"
            case TypeKind.`UIntNative` => "UIntNative"
            case TypeKind.`Float16` => "Float16"
            case TypeKind.`Float32` => "Float32"
            case TypeKind.`Float64` => "Float64"
            case TypeKind.`Rune` => "Rune"
            case TypeKind.`Nothing` => "Nothing"
            case TypeKind.`Bool` => "Bool"
            case TypeKind.Tuple => "Tuple"
            case TypeKind.Enum => "Enum"
            case TypeKind.Func => "Func"
            case TypeKind.Struct => "Struct"
            case TypeKind.Array => "Array"
            case TypeKind.`VArray` => "VArray"
            case TypeKind.CPointer => "CPointer"
            case TypeKind.CString => "CString"
            case TypeKind.Class => "Class"
            case TypeKind.Interface => "Interface"
            case TypeKind.Type => "Type"
            case TypeKind.Generic => "Generic"
            case TypeKind.Unknown(v) => "Unknown(${v})"
        }
    }
}

public enum SemaTyInfo {
    | AsFuncTyInfo(FuncTyInfo)
    | AsCompositeTyInfo(CompositeTyInfo)
    | AsGenericTyInfo(GenericTyInfo)
    | AsArrayTyInfo(ArrayTyInfo)
    /**
     * A member this version of the schema does not have, by its type.
     */
    | Unknown(UInt8)

    /**
     * The union of field `id` (its type; `id + 1` is its value), if it is there.
     */
    static func read(fb: FbTable, id: Int64): ?SemaTyInfo {
        let tag = fb.scalar(id, 0, readUInt8)
        if (tag == 0) {
            return Option<SemaTyInfo>.None
        }
        let o = fb.offset(id + 1)
        if (o == 0) {
            throw broken("SemaTyInfo of type ${tag} has no value")
        }
        at(fb.buf, tag, fb.pos + o)
    }

    /**
     * The vector of unions of field `id` (their types; `id + 1` is their values).
     */
    static func readVector(fb: FbTable, id: Int64): FbVector<SemaTyInfo> {
        let tags = fb.vector(id, 1, readUInt8)
        let values = fb.vector(id + 1, 4) {_, p => p}
        if (tags.size != values.size) {
            throw broken("SemaTyInfo: ${tags.size} types for ${values.size} values")
        }
        FbVector<SemaTyInfo>(fb.buf, values.start, values.size, 4) {b, p => at(b, tags[(p - values.start) / 4], p)}
    }

    /**
     * The member of type `tag` whose offset is stored at `pos`.
     */
    static func at(buf: Array<Byte>, tag: UInt8, pos: Int64): SemaTyInfo {
        match (tag) {
            case 1 => SemaTyInfo.AsFuncTyInfo(FuncTyInfo(FbTable.at(buf, pos)))
            case 2 => SemaTyInfo.AsCompositeTyInfo(CompositeTyInfo(FbTable.at(buf, pos)))
            case 3 => SemaTyInfo.AsGenericTyInfo(GenericTyInfo(FbTable.at(buf, pos)))
            case 4 => SemaTyInfo.AsArrayTyInfo(ArrayTyInfo(FbTable.at(buf, pos)))
            case _ => SemaTyInfo.Unknown(tag)
        }
    }
}

public struct FuncTyInfo {
    FuncTyInfo(let fb: FbTable) {}

    /**
     * Func return type
     */
    public prop retType: UInt32 {
        get() {
            fb.scalar(0, 0, readUInt32)
        }
    }

    /**
     * CFunc or @C func type.
     */
    public prop isC: Bool {
        get() {
            fb.scalar(1, false, readBool)
        }
    }

    public prop hasVariableLenArg: Bool {
        get() {
            fb.scalar(2, false, readBool)
        }
    }
}

