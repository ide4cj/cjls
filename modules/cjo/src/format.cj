    CompositeTyInfo(let fb: FbTable) {}

    public prop declPtr: ?FullId {
        get() {
            fb.table(0).map {x => FullId(x)}
        }
    }

    public prop isThisTy: Bool {
        get() {
            fb.scalar(1, false, readBool)
        }
    }
}

public struct GenericTyInfo {
