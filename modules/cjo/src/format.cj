            case PatternKind.VarPattern => "VarPattern"
            case PatternKind.TuplePattern => "TuplePattern"
            case PatternKind.TypePattern => "TypePattern"
            case PatternKind.EnumPattern => "EnumPattern"
            case PatternKind.ExceptTypePattern => "ExceptTypePattern"
            case PatternKind.CommandTypePattern => "CommandTypePattern"
        }
