public enum ExprInfo {
    | AsCallInfo(CallInfo)
    | AsUnaryInfo(UnaryInfo)
    | AsBinaryInfo(BinaryInfo)
    | AsIncOrDecInfo(IncOrDecInfo)
    | AsLitConstInfo(LitConstInfo)
    | AsReferenceInfo(ReferenceInfo)
    | AsLambdaInfo(LambdaInfo)
    | AsAssignInfo(AssignInfo)
    | AsArrayInfo(ArrayInfo)
    | AsJumpInfo(JumpInfo)
    | AsFuncArgInfo(FuncArgInfo)
    | AsSubscriptInfo(SubscriptInfo)
    | AsMatchInfo(MatchInfo)
    | AsBlockInfo(BlockInfo)
    | AsTryInfo(TryInfo)
    | AsLetPatternDestructorInfo(LetPatternDestructorInfo)
    | AsForInInfo(ForInInfo)
    | AsMatchCaseInfo(MatchCaseInfo)
    | AsSpawnInfo(SpawnInfo)
    /**
     * A member this version of the schema does not have, by its type.
     */
    | Unknown(UInt8)

    /**
     * The union of field `id` (its type; `id + 1` is its value), if it is there.
     */
    static func read(fb: FbTable, id: Int64): ?ExprInfo {
        let tag = fb.scalar(id, 0, readUInt8)
        if (tag == 0) {
            return Option<ExprInfo>.None
        }
        let o = fb.offset(id + 1)
        if (o == 0) {
            throw broken("ExprInfo of type ${tag} has no value")
        }
        at(fb.buf, tag, fb.pos + o)
    }

    /**
     * The vector of unions of field `id` (their types; `id + 1` is their values).
     */
    static func readVector(fb: FbTable, id: Int64): FbVector<ExprInfo> {
        let tags = fb.vector(id, 1, readUInt8)
        let values = fb.vector(id + 1, 4) {_, p => p}
        if (tags.size != values.size) {
            throw broken("ExprInfo: ${tags.size} types for ${values.size} values")
        }
        FbVector<ExprInfo>(fb.buf, values.start, values.size, 4) {b, p => at(b, tags[(p - values.start) / 4], p)}
    }

    /**
     * The member of type `tag` whose offset is stored at `pos`.
     */
    static func at(buf: Array<Byte>, tag: UInt8, pos: Int64): ExprInfo {
        match (tag) {
            case 1 => ExprInfo.AsCallInfo(CallInfo(FbTable.at(buf, pos)))
            case 2 => ExprInfo.AsUnaryInfo(UnaryInfo(FbTable.at(buf, pos)))
            case 3 => ExprInfo.AsBinaryInfo(BinaryInfo(FbTable.at(buf, pos)))
            case 4 => ExprInfo.AsIncOrDecInfo(IncOrDecInfo(FbTable.at(buf, pos)))
            case 5 => ExprInfo.AsLitConstInfo(LitConstInfo(FbTable.at(buf, pos)))
            case 6 => ExprInfo.AsReferenceInfo(ReferenceInfo(FbTable.at(buf, pos)))
            case 7 => ExprInfo.AsLambdaInfo(LambdaInfo(FbTable.at(buf, pos)))
            case 8 => ExprInfo.AsAssignInfo(AssignInfo(FbTable.at(buf, pos)))
            case 9 => ExprInfo.AsArrayInfo(ArrayInfo(FbTable.at(buf, pos)))
            case 10 => ExprInfo.AsJumpInfo(JumpInfo(FbTable.at(buf, pos)))
            case 11 => ExprInfo.AsFuncArgInfo(FuncArgInfo(FbTable.at(buf, pos)))
            case 12 => ExprInfo.AsSubscriptInfo(SubscriptInfo(FbTable.at(buf, pos)))
            case 13 => ExprInfo.AsMatchInfo(MatchInfo(FbTable.at(buf, pos)))
            case 14 => ExprInfo.AsBlockInfo(BlockInfo(FbTable.at(buf, pos)))
            case 15 => ExprInfo.AsTryInfo(TryInfo(FbTable.at(buf, pos)))
            case 16 => ExprInfo.AsLetPatternDestructorInfo(LetPatternDestructorInfo(FbTable.at(buf, pos)))
            case 17 => ExprInfo.AsForInInfo(ForInInfo(FbTable.at(buf, pos)))
            case 18 => ExprInfo.AsMatchCaseInfo(MatchCaseInfo(FbTable.at(buf, pos)))
            case 19 => ExprInfo.AsSpawnInfo(SpawnInfo(FbTable.at(buf, pos)))
            case _ => ExprInfo.Unknown(tag)
        }
    }
}

