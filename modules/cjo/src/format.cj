public enum DeclInfo {
    | AsClassInfo(ClassInfo)
    | AsInterfaceInfo(InterfaceInfo)
    | AsStructInfo(StructInfo)
    | AsEnumInfo(EnumInfo)
    | AsExtendInfo(ExtendInfo)
    | AsPropInfo(PropInfo)
    | AsVarInfo(VarInfo)
    | AsVarWithPatternInfo(VarWithPatternInfo)
    | AsParamInfo(ParamInfo)
    | AsFuncInfo(FuncInfo)
    | AsBuiltInInfo(BuiltInInfo)
    | AsAliasInfo(AliasInfo)
    /**
     * A member this version of the schema does not have, by its type.
     */
    | Unknown(UInt8)

    /**
     * The union of field `id` (its type; `id + 1` is its value), if it is there.
     */
    static func read(fb: FbTable, id: Int64): ?DeclInfo {
        let tag = fb.scalar(id, 0, readUInt8)
        if (tag == 0) {
            return Option<DeclInfo>.None
        }
        let o = fb.offset(id + 1)
        if (o == 0) {
            throw broken("DeclInfo of type ${tag} has no value")
        }
        at(fb.buf, tag, fb.pos + o)
    }

    /**
     * The vector of unions of field `id` (their types; `id + 1` is their values).
     */
    static func readVector(fb: FbTable, id: Int64): FbVector<DeclInfo> {
        let tags = fb.vector(id, 1, readUInt8)
        let values = fb.vector(id + 1, 4) {_, p => p}
        if (tags.size != values.size) {
            throw broken("DeclInfo: ${tags.size} types for ${values.size} values")
        }
        FbVector<DeclInfo>(fb.buf, values.start, values.size, 4) {b, p => at(b, tags[(p - values.start) / 4], p)}
    }

    /**
     * The member of type `tag` whose offset is stored at `pos`.
     */
    static func at(buf: Array<Byte>, tag: UInt8, pos: Int64): DeclInfo {
        match (tag) {
            case 1 => DeclInfo.AsClassInfo(ClassInfo(FbTable.at(buf, pos)))
            case 2 => DeclInfo.AsInterfaceInfo(InterfaceInfo(FbTable.at(buf, pos)))
            case 3 => DeclInfo.AsStructInfo(StructInfo(FbTable.at(buf, pos)))
            case 4 => DeclInfo.AsEnumInfo(EnumInfo(FbTable.at(buf, pos)))
            case 5 => DeclInfo.AsExtendInfo(ExtendInfo(FbTable.at(buf, pos)))
            case 6 => DeclInfo.AsPropInfo(PropInfo(FbTable.at(buf, pos)))
            case 7 => DeclInfo.AsVarInfo(VarInfo(FbTable.at(buf, pos)))
            case 8 => DeclInfo.AsVarWithPatternInfo(VarWithPatternInfo(FbTable.at(buf, pos)))
            case 9 => DeclInfo.AsParamInfo(ParamInfo(FbTable.at(buf, pos)))
            case 10 => DeclInfo.AsFuncInfo(FuncInfo(FbTable.at(buf, pos)))
            case 11 => DeclInfo.AsBuiltInInfo(BuiltInInfo(FbTable.at(buf, pos)))
            case 12 => DeclInfo.AsAliasInfo(AliasInfo(FbTable.at(buf, pos)))
            case _ => DeclInfo.Unknown(tag)
        }
    }
}

public struct Decl {
    Decl(let fb: FbTable) {}

    public prop kind: DeclKind {
        get() {
            DeclKind.fromValue(fb.scalar(0, 0, readUInt16))
        }
    }

    /**
     * whether the decl is toplevel
     */
    public prop isTopLevel: Bool {
        get() {
            fb.scalar(1, false, readBool)
        }
    }

    public prop fullPkgName: ?String {
        get() {
            fb.string(2)
        }
    }

    public prop genericDecl: ?FullId {
        get() {
            fb.table(3).map {x => FullId(x)}
        }
    }

    public prop generic: ?Generics {
        get() {
            fb.table(4).map {x => Generics(x)}
        }
    }

    public prop begin: ?Position {
        get() {
            fb.structAt(5).map {p => Position(fb.buf, p)}
        }
    }

    public prop end: ?Position {
        get() {
            fb.structAt(6).map {p => Position(fb.buf, p)}
        }
    }

    public prop identifier: ?String {
        get() {
            fb.string(7)
        }
    }

    public prop identifierPos: ?Position {
        get() {
            fb.structAt(8).map {p => Position(fb.buf, p)}
        }
    }

    public prop attributes: Attributes {
        get() {
            Attributes(fb.vector(9, 8, readUInt64))
        }
    }

    public prop annotations: FbVector<Anno> {
        get() {
            fb.vector(10, 4, {b, p => Anno(FbTable.at(b, p))})
        }
    }

    /**
     * Semantic & CodeGen info
     */
    public prop `type`: UInt32 {
        get() {
            fb.scalar(11, 0, readUInt32)
        }
    }

    /**
     * mangledName for CodeGen
     */
    public prop mangledName: ?String {
        get() {
            fb.string(12)
        }
    }

    /**
     * exportId for import
     */
    public prop exportId: ?String {
        get() {
            fb.string(13)
        }
    }

    /**
     * info used in ast diff
     */
    public prop mangledBeforeSema: ?String {
        get() {
            fb.string(14)
        }
    }

    public prop hash: ?DeclHash {
        get() {
            fb.structAt(15).map {p => DeclHash(fb.buf, p)}
        }
    }

    /**
     * Specific information for each specific kind of declaration
     */
    public prop info: ?DeclInfo {
        get() {
            DeclInfo.read(fb, 16)
        }
    }

    /**
     * record dependencies result of common part for CJMP
     */
    public prop dependencies: FbVector<FullId> {
        get() {
            fb.vector(18, 4, {b, p => FullId(FbTable.at(b, p))})
        }
    }
}

