    public prop majorNum: UInt8 {
        get() {
            readUInt8(buf, pos)
        }
    }

    public prop minorNum: UInt8 {
        get() {
            readUInt8(buf, pos + 1)
        }
    }

    public prop patchNum: UInt8 {
        get() {
            readUInt8(buf, pos + 2)
        }
    }
}

