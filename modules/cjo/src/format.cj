    public prop value: UInt8 {
        get() {
            match (this) {
                case CallKind.NA => 0
                case CallKind.CallDeclaredFunction => 1
                case CallKind.CallObjectCreation => 2
                case CallKind.CallStructCreation => 3
                case CallKind.CallSuperFunction => 4
                case CallKind.CallVariadicFunction => 5
                case CallKind.CallFunctionPtr => 6
                case CallKind.CallAnnotation => 7
                case CallKind.CallBuiltinFunction => 8
                case CallKind.CallIntrinsicFunction => 9
            }
        }
    }

    public operator func ==(other: CallKind): Bool {
        value == other.value
    }

    public operator func !=(other: CallKind): Bool {
        value != other.value
    }

    public func hashCode(): Int64 {
        Int64(value)
    }

    public func toString(): String {
        match (this) {
            case CallKind.NA => "NA"
            case CallKind.CallDeclaredFunction => "CallDeclaredFunction"
            case CallKind.CallObjectCreation => "CallObjectCreation"
            case CallKind.CallStructCreation => "CallStructCreation"
            case CallKind.CallSuperFunction => "CallSuperFunction"
            case CallKind.CallVariadicFunction => "CallVariadicFunction"
            case CallKind.CallFunctionPtr => "CallFunctionPtr"
            case CallKind.CallAnnotation => "CallAnnotation"
            case CallKind.CallBuiltinFunction => "CallBuiltinFunction"
            case CallKind.CallIntrinsicFunction => "CallIntrinsicFunction"
        }
    }
}

