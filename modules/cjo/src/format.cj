    }

    public func toString(): String {
        match (this) {
            case OptimizationLevel.O0 => "O0"
            case OptimizationLevel.O1 => "O1"
            case OptimizationLevel.O2 => "O2"
            case OptimizationLevel.O3 => "O3"
            case OptimizationLevel.Os => "Os"
            case OptimizationLevel.Oz => "Oz"
        }
    }
}

public struct CompilationOptions {
    CompilationOptions(let fb: FbTable) {}

    public prop optimizationLevel: OptimizationLevel {
        get() {
            OptimizationLevel.fromValue(fb.scalar(0, 0, readUInt8))
        }
    }

    public prop debug: Bool {
        get() {
            fb.scalar(1, false, readBool)
        }
    }
}

/**
 * all SemaTys, decls are saved here, and indexed by other nodes.
 */
public struct Package {
    Package(let fb: FbTable) {}

    /**
     * What a file of this schema has at bytes 4 to 8.
     */
    static let FILE_IDENTIFIER = "CJOF"

    /**
     * The root table of `buf`, nothing checked.
     */
    static func root(buf: Array<Byte>): Package {
        Package(FbTable.at(buf, 0))
    }

    /**
     * cjc version.
     */
    public prop version: ?String {
        get() {
            fb.string(0)
        }
    }

    /**
     * cjo format version.
     */
    public prop cjoVersion: ?CjoVersion {
        get() {
            fb.structAt(1).map {p => CjoVersion(fb.buf, p)}
        }
    }

    /**
     * full package name.
     */
    public prop fullPkgName: ?String {
        get() {
            fb.string(2)
        }
    }

    /**
     * package dependency info.
     */
    public prop pkgDepInfo: ?String {
        get() {
            fb.string(3)
        }
    }

    /**
     * all imported packages.
     */
    public prop imports: FbVector<String> {
        get() {
            fb.vector(4, 4, readString)
        }
    }

    /**
     * all files in package.
     */
    public prop allFiles: FbVector<String> {
        get() {
            fb.vector(5, 4, readString)
        }
    }

    /**
     * all file imports in package.
     */
    public prop allFileImports: FbVector<Imports> {
        get() {
            fb.vector(6, 4, {b, p => Imports(FbTable.at(b, p))})
        }
    }

    /**
     * all saved SemaTys.
     */
    public prop allTypes: FbVector<SemaTy> {
        get() {
            fb.vector(7, 4, {b, p => SemaTy(FbTable.at(b, p))})
        }
    }

    /**
     * all saved decls.
     */
    public prop allDecls: FbVector<Decl> {
        get() {
            fb.vector(8, 4, {b, p => Decl(FbTable.at(b, p))})
        }
    }

    /**
     * all saved expressions.
     */
    public prop allExprs: FbVector<Expr> {
        get() {
            fb.vector(9, 4, {b, p => Expr(FbTable.at(b, p))})
        }
    }

    /**
     * all saved constant composite values.
     */
    public prop allValues: FbVector<CompositeValue> {
        get() {
            fb.vector(10, 4, {b, p => CompositeValue(FbTable.at(b, p))})
        }
    }

    /**
     * package kind.
     */
    public prop kind: PackageKind {
        get() {
            PackageKind.fromValue(fb.scalar(11, 0, readUInt8))
        }
    }

    public prop access: AccessLevel {
        get() {
            AccessLevel.fromValue(fb.scalar(12, 0, readUInt8))
        }
    }

    public prop moduleName: ?String {
        get() {
            fb.string(13)
        }
    }

    /**
     * append some info of File for CJMP
     */
    public prop allFileInfo: FbVector<FileInfo> {
        get() {
            fb.vector(14, 4, {b, p => FileInfo(FbTable.at(b, p))})
        }
    }

    /**
     * record all std full package name dependencies.
     */
    public prop allDependentStdPkgs: FbVector<String> {
        get() {
            fb.vector(15, 4, readString)
        }
    }

    public prop options: ?CompilationOptions {
        get() {
            fb.table(16).map {x => CompilationOptions(x)}
        }
    }
}
