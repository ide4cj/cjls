public enum OptimizationLevel {
    | O0
    | O1
    | O2
    | O3
    | Os
    | Oz
}

extend OptimizationLevel <: Hashable & Equatable<OptimizationLevel> & ToString {
    static func fromValue(value: UInt8): OptimizationLevel {
        match (value) {
            case 0 => OptimizationLevel.O0
            case 1 => OptimizationLevel.O1
            case 2 => OptimizationLevel.O2
            case 3 => OptimizationLevel.O3
            case 4 => OptimizationLevel.Os
            case 5 => OptimizationLevel.Oz
            case _ => throw broken("OptimizationLevel has no value ${value}")
        }
    }

    /**
     * Its value in the file.
     */
