}

public struct SemaTy {
    SemaTy(let fb: FbTable) {}

    public prop kind: TypeKind {
        get() {
            TypeKind.fromValue(fb.scalar(0, 1, readUInt16))
        }
    }

    /**
     * TypeArguments, also for funcTy's paramTypes
     */
    public prop typeArgs: FbVector<UInt32> {
        get() {
            fb.vector(1, 4, readUInt32)
        }
    }

    public prop info: ?SemaTyInfo {
        get() {
            SemaTyInfo.read(fb, 2)
        }
    }
}

public enum AccessModifier {
    | Private
    | Internal
    | Protected
    | Public
}

extend AccessModifier <: Hashable & Equatable<AccessModifier> & ToString {
    static func fromValue(value: UInt8): AccessModifier {
        match (value) {
            case 0 => AccessModifier.Private
            case 1 => AccessModifier.Internal
            case 2 => AccessModifier.Protected
            case 3 => AccessModifier.Public
            case _ => throw broken("AccessModifier has no value ${value}")
        }
    }

    /**
     * Its value in the file.
     */
    public prop value: UInt8 {
        get() {
            match (this) {
                case AccessModifier.Private => 0
                case AccessModifier.Internal => 1
                case AccessModifier.Protected => 2
                case AccessModifier.Public => 3
            }
        }
    }

    public operator func ==(other: AccessModifier): Bool {
        value == other.value
    }

    public operator func !=(other: AccessModifier): Bool {
        value != other.value
    }

    public func hashCode(): Int64 {
        Int64(value)
    }

    public func toString(): String {
        match (this) {
            case AccessModifier.Private => "Private"
            case AccessModifier.Internal => "Internal"
            case AccessModifier.Protected => "Protected"
            case AccessModifier.Public => "Public"
        }
    }
}

public struct ImportSpec {
    ImportSpec(let fb: FbTable) {}

    public prop begin: ?Position {
        get() {
            fb.structAt(0).map {p => Position(fb.buf, p)}
        }
    }

    public prop end: ?Position {
        get() {
            fb.structAt(1).map {p => Position(fb.buf, p)}
        }
    }

    public prop prefixPaths: FbVector<String> {
        get() {
            fb.vector(2, 4, readString)
        }
    }

    public prop identifier: ?String {
        get() {
            fb.string(3)
        }
    }

    public prop asIdentifier: ?String {
        get() {
            fb.string(4)
        }
    }

    public prop reExport: AccessModifier {
        get() {
            AccessModifier.fromValue(fb.scalar(5, 0, readUInt8))
        }
    }

    public prop isDecl: Bool {
        get() {
            fb.scalar(6, false, readBool)
        }
    }

    public prop hasDoubleColon: Bool {
        get() {
            fb.scalar(7, false, readBool)
        }
    }

    public prop withImplicitExport: Bool {
        get() {
            fb.scalar(8, true, readBool)
        }
    }
}

public struct Imports {
    Imports(let fb: FbTable) {}

    public prop importSpecs: FbVector<ImportSpec> {
        get() {
            fb.vector(0, 4, {b, p => ImportSpec(FbTable.at(b, p))})
        }
    }
}

public enum PackageKind {
    /**
     * normal package.
     */
    | Normal
    /**
     * macro package.
     */
    | Macro
    /**
     * foreign language package.
     */
    | Foreign
    /**
     * package with mocking support.
     */
    | Mock
    /**
     * A value this version of the schema does not have.
     */
    | Unknown(UInt8)
}

extend PackageKind <: Hashable & Equatable<PackageKind> & ToString {
    static func fromValue(value: UInt8): PackageKind {
        match (value) {
            case 0 => PackageKind.Normal
            case 1 => PackageKind.Macro
            case 2 => PackageKind.Foreign
            case 3 => PackageKind.Mock
            case _ => PackageKind.Unknown(value)
        }
    }

    /**
     * Its value in the file.
     */
    public prop value: UInt8 {
        get() {
            match (this) {
                case PackageKind.Normal => 0
                case PackageKind.Macro => 1
                case PackageKind.Foreign => 2
                case PackageKind.Mock => 3
                case PackageKind.Unknown(v) => v
            }
        }
    }

    public operator func ==(other: PackageKind): Bool {
        value == other.value
    }

    public operator func !=(other: PackageKind): Bool {
        value != other.value
    }

    public func hashCode(): Int64 {
        Int64(value)
    }

    public func toString(): String {
        match (this) {
            case PackageKind.Normal => "Normal"
            case PackageKind.Macro => "Macro"
            case PackageKind.Foreign => "Foreign"
            case PackageKind.Mock => "Mock"
            case PackageKind.Unknown(v) => "Unknown(${v})"
        }
    }
}

public enum AccessLevel {
    | Public
