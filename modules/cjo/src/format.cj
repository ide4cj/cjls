                case PatternKind.WildcardPattern => 2
                case PatternKind.VarPattern => 3
                case PatternKind.TuplePattern => 4
                case PatternKind.TypePattern => 5
                case PatternKind.EnumPattern => 6
                case PatternKind.ExceptTypePattern => 7
                case PatternKind.CommandTypePattern => 8
