package loupe.hir

import std.collection.*
import std.deriving.*
import ginkgo.TextRange
import cjsyntax.{CjParse, CjSyntaxNode, SyntaxKind, parseExpr, parseStmts}
import cjsyntax.ast.{AnyHasName, Decl, MacroExpandDecl, MatchCase}
import cjsyntax.parse as parseText
import calca.*
import calca.macros.*
import loupe.db.{AnalysisDatabase, MappedSpan, MappedText, SourceFile, SpanOrigin}
import loupe.syntax.parse

/**
 * A macro called in a source file, interned: the file and the item, and which of its calls. On the item (#175), the
 * macro among those called on it, outermost first (`index` in `Item.macros`), or on one of its parameters, after
 * those (`macroCallChainsOf`, D119), `inBody` `None`. In it, in a body or an initializer (D117), the macro's name as
 * written (`inBody`) and its ordinal among the calls of that name there (`index`), in the order their `@`s are
 * written. What a call on an item adds is `ItemFile.Expansion` of it.
 */
@CalcaInterned
public struct MacroCallId {
    public let file: SourceFile
    public let item: ItemId
    public let index: Int64
    public let inBody: ?String
}

/**
 * What written in a macro call an item of its expansion comes from, where go to definition goes for it or a member
 * of it.
 */
@Derive[Equatable]
public enum ExpansionOrigin {
    /**
     * The interface of `@Derive[...]` at this index there.
     */
    | OfEntry(Int64)
    /**
     * The macro's name in the call: `@Test`'s.
     */
    | OfMacro
    /**
     * The name of the declaration the call is on: the function `@Strategy` replaces.
     */
    | OfName
    /**
     * The option `@UnittestOption[...](...)` names.
     */
    | OfOption
}

/**
 * What a macro call adds after its item, as text cjsyntax parses: declarations, signatures alone, each body a comment
 * (`stubBody`); for each item of it in order, what written in the call it comes from; and whether it replaces the
 * item the call is on, which then declares nothing (`@Strategy`'s function, whose body stays in a lambda of the `let`
 * it becomes). One the macro server ran (#176), of the workspace or of std, is its whole output, replacing the item,
 * and says where each of its tokens comes from by `spans` instead of `origins`.
 */
@Derive[Equatable]
public struct Expansion {
    public Expansion(
        public let text: String,
        public let origins: Array<ExpansionOrigin>,
        public let replaces!: Bool = false,
        public let spans!: Array<MappedSpan> = []
    ) {}
}

/**
 * The body of a member cjls writes itself for the call of `macroName` (`@Derive`), the member at `indent` (D118): a
 * block, which the editor folds, of a comment saying whose the body is and nothing else. The analysis lowers no body
 * of an expansion it writes (`bodyWithSourceMap`, only the macro server's), so an empty one is typed by nothing and
 * reported by nothing. The parser needs
 * one in an `extend` or a `struct`, and so does a workspace macro the `extend` is sent to (D114).
 */
func stubBody(indent: String, macroName: String): String {
    "{\n${indent}    // body generated by ${macroName}\n${indent}}"
}

/**
 * A macro of std the analysis expands (#175).
 */
@Derive[Equatable]
enum StdMacro {
    /**
     * `std.deriving`'s `@Derive`, on a class, struct or enum.
     */
    | DeriveMacro
    /**
     * `std.unittest.testmacro`'s `@Test`, on a class or a function.
     */
    | TestMacro
    /**
     * `@TestTemplate`, on a class.
     */
    | TestTemplateMacro
    /**
     * `@TestBuilder`, on a function.
     */
    | TestBuilderMacro
    /**
     * `@Strategy`, on a function.
     */
    | StrategyMacro
    /**
     * `@UnittestOption[...](...)`, a call on no declaration.
     */
    | UnittestOptionMacro

    /**
     * The macro of std the declaration `pkg`.`name` is, if it is one the analysis expands.
     */
    static func named(pkg: String, name: String): ?StdMacro {
        match ((pkg, name)) {
            case ("std.deriving", "Derive") => DeriveMacro
            case ("std.unittest.testmacro", "Test") => TestMacro
            case ("std.unittest.testmacro", "TestTemplate") => TestTemplateMacro
            case ("std.unittest.testmacro", "TestBuilder") => TestBuilderMacro
            case ("std.unittest.testmacro", "Strategy") => StrategyMacro
            case ("std.unittest.testmacro", "UnittestOption") => UnittestOptionMacro
            case _ => None
        }
    }

    /**
     * Whether it takes an item of `kind`; on any other, cjc's macro fails, and adds nothing.
     */
    func takes(kind: ItemKind): Bool {
        match (this) {
            case DeriveMacro =>
                kind == ItemKind.Class || kind == ItemKind.Struct || kind == ItemKind.Enum
            case TestMacro => kind == ItemKind.Class || kind == ItemKind.Func
            case TestTemplateMacro => kind == ItemKind.Class
            case TestBuilderMacro | StrategyMacro => kind == ItemKind.Func
            case UnittestOptionMacro => kind == ItemKind.MacroCall
        }
    }

    /**
     * Whether it is one of the macros of `std.unittest.testmacro` of which only the outermost on an item rewrites it,
     * the others seen as its configuration (`topLevelMacroDriver`).
     */
    prop drivesTheItem: Bool {
        get() {
            match (this) {
                case TestMacro | TestTemplateMacro | TestBuilderMacro => true
                case _ => false
            }
        }
    }
}

/**
 * The package and the name of the macro `resolution`, of a macro's name, is: of all its declarations, for a macro with
 * and without an attribute is two of one name, which a lookup finds ambiguous (`Test(input)`, `Test(attr, input)`);
 * `None` if it is not one macro.
 */
func macroPathOf(db: AnalysisDatabase, resolution: Resolution): ?(String, String) {
    let ids = macroDeclsOf(resolution)
    if (ids.isEmpty()) {
        return None
    }
    let paths =
        ids
            .map {
                id =>
                match ((packageRefOf(db, id), (itemOf(db, id)?.names ?? []).get(0))) {
                    case (Some(pkg), Some(name)) => Some((nameOf(db, pkg), name))
                    case _ => None<(String, String)>
                }
            }
    let first = paths[0] ?? return None
    let same =
        paths
            .iterator()
            .all {
                one =>
                match (one) {
                    case Some((pkg, name)) => pkg == first[0] && name == first[1]
                    case None => false
                }
            }
    if (same) {
        first
    } else {
        None
    }
}

/**
 * The declarations `resolution`, of a macro's name, finds: one, or the two of a macro with and without an attribute;
 * none if it finds something else than declarations.
 */
func macroDeclsOf(resolution: Resolution): Array<DefId> {
    match (resolution) {
        case Found(ids) => ids
        case Ambiguous(targets) =>
            let decls =
                targets |>
                    filterMap {
                        one: ScopeTarget =>
                        match (one) {
                            case OfDecl(id) => Some(id)
                            case OfPackage(_) => None<DefId>
                        }
                    } |>
                    collectArray
            if (decls.size == targets.size) {
                decls
            } else {
                []
            }
        case _ => []
    }
}

/**
 * The macro of std `resolution`, of a macro's name, is, if it is one the analysis expands.
 */
func stdMacroOf(db: AnalysisDatabase, resolution: Resolution): ?StdMacro {
    let (pkg, name) = macroPathOf(db, resolution) ?? return None
    StdMacro.named(pkg, name)
}

/**
 * Whether what the macro `resolution` names adds to a declaration, a member if `onMember`, is known: std's
 * `std.deriving` and `std.unittest.testmacro` macros, which the analysis expands or which add nothing a name reaches
 * (`@DeriveExclude`, `@TestCase`, `@Configure`, `@Test` on a member, ...; #175), but `@Strategy` on a member, which
 * cjc makes a `prop` of its class and the analysis does not expand.
 */
public func isReadMacro(db: AnalysisDatabase, resolution: Resolution, onMember!: Bool): Bool {
    match (macroPathOf(db, resolution)) {
        case Some(("std.deriving", _)) => true
        case Some(("std.unittest.testmacro", "Strategy")) => !onMember
        case Some(("std.unittest.testmacro", _)) => true
        case _ => false
    }
}

/**
 * The macro calls on the items of `file` the analysis expands, each with its macro: std's `@Derive` on a type, and
 * what of `std.unittest.testmacro` declares (`@Test`, `@TestTemplate`, `@TestBuilder`, `@Strategy`, `@UnittestOption`),
 * on a declaration of the file's top level. A macro is std's when its name resolves to std's through the file's
 * imports, not by its name alone (`macrosOf`). Of `@Test`, `@TestTemplate` and `@TestBuilder` on one item, only the
 * outermost.
 */
func stdCallsOf(db: AnalysisDatabase, file: SourceFile): Array<(MacroCallId, StdMacro)> {
    let found = ArrayList<(MacroCallId, StdMacro)>()
    for (item in activeItemTree(db, file).items where !item.macros.isEmpty()) {
        let macros = macrosOf(db, DefId(db, ItemFile.Source(file), item.id))
        var driven = false
        // those on the item: a call on one of its parameters (D119) is read through the call on the item alone; none
        // resolves in a file of no package, whose `macrosOf` is empty
        for (i in 0..item.macros.size) {
            let stdMacro = macros.get(i).flatMap { one => stdMacroOf(db, one) } ?? continue
            if (!stdMacro.takes(item.kind) || (stdMacro.drivesTheItem && driven)) {
                continue
            }
            driven = driven || stdMacro.drivesTheItem
            found.add((MacroCallId(db, file, item.id, i, None), stdMacro))
        }
    }
    found.toArray()
}

/**
 * The macro calls on the items of `file` whose expansions the analysis reads: those of std it expands (`stdCallsOf`),
 * in their order, then those the macro server expanded (`serverCalls`, #176). An item the server's output replaces
 * has none of the first: that output is what std's macros made of it, and the analysis's own stands until there is
 * one, and whenever the server cannot give it.
 */
@CalcaTracked
public func expandedCalls(db: AnalysisDatabase, file: SourceFile): Array<MacroCallId> {
    let read = readServerCallsOf(db, file)
    let replaced = HashSet<ItemId>(read.map { call => call.item(db) })
    stdCallsOf(db, file)
        .map { pair => pair[0] }
        .filter { call => !replaced.contains(call.item(db)) }
        .concat(read)
}

/**
 * The files of the expansions of the macro calls in `file`, in their order; none for a file of a package compiled
 * already, whose macros were expanded, nor for an expansion.
 */
public func expansionsOf(db: AnalysisDatabase, file: ItemFile): Array<ItemFile> {
    match (file) {
        case Source(source) => expandedCalls(db, source).map { call => ItemFile.Expansion(call) }
        case _ => []
    }
}

/**
 * The items of the files the expansions `files` are of that one of them replaces.
 */
func replacedItemsOf(db: AnalysisDatabase, files: Array<ItemFile>): Array<ItemId> {
    files |>
        filterMap {
            file: ItemFile =>
            match (file) {
                case Expansion(call) where macroExpansion(db, call).replaces => call.item(db)
                case _ => None<ItemId>
            }
        } |>
        collectArray
}

/**
 * The `Expansion` of `call`; an empty one for a call the analysis does not expand, or on an item no longer there. A
 * call the macro server ran has its last output that succeeded (#176), else one of std the analysis's own. A call in an
 * item (D117) has the server's, which takes the call's place, whether or not the body reads it (#369).
 */
@CalcaTracked
public func macroExpansion(db: AnalysisDatabase, call: MacroCallId): Expansion {
    let empty = Expansion("", [])
    let file = call.file(db)
    let item = call.item(db)
    if (call.inBody(db).isSome()) {
        if (!serverCalls(db, file).iterator().any { one => one.call == call }) {
            return empty
        }
        let output = serverExpansionOf(db, call) ?? return empty
        return Expansion(output.text, [], replaces: true, spans: output.spans)
    }
    if (!expandedCalls(db, file).contains(call)) {
        return empty
    }
    if (let Some(expansion) <- serverCallExpansionOf(db, call)) {
        return expansion
    }
    let resolution =
        macrosOf(db, DefId(db, ItemFile.Source(file), item)).get(call.index(db)) ?? return empty
    let stdMacro = stdMacroOf(db, resolution) ?? return empty
    let root = parse(db, file).syntaxNode()
    let node = itemIdMap(db, file).node(item, root) ?? return empty
    let decl = Decl.cast(node) ?? return empty
    let macroCall = macroCallsOf(node).get(call.index(db)) ?? return empty
    let expansion =
        match (stdMacro) {
            case DeriveMacro => deriveExpansion(decl, macroCall)
            case TestMacro where item.kind == ItemKind.Func => testFuncExpansion(decl)
            case TestMacro => testClassExpansion(decl, template: false)
            case TestTemplateMacro => testClassExpansion(decl, template: true)
            case TestBuilderMacro => testBuilderExpansion(decl)
            case StrategyMacro => strategyExpansion(decl)
            case UnittestOptionMacro => optionExpansion(macroCall)
        }
    expansion ?? empty
}

/**
 * What the output of a macro call is parsed as, by where the call stands (D117): rust-analyzer's `ExpandTo`.
 */
@Derive[Equatable]
public enum ExpandTo <: ToString {
    /**
     * Declarations, as a file holds them (`parse`): a call on an item.
     */
    | ToItems
    /**
     * One expression (`parseExpr`): a call in an item anywhere but where a block's statement stands.
     */
    | ToExpr
    /**
     * Statements, as a block holds them (`parseStmts`): a call in an item where a block's statement stands, in a
     * block, a lambda, an interpolation, or a `match` case after its `=>`, each of which cjc reads as a block.
     */
    | ToStmts

    public func toString(): String {
        match (this) {
            case ToItems => "ToItems"
            case ToExpr => "ToExpr"
            case ToStmts => "ToStmts"
        }
    }
}

/**
 * What the output of `call` is parsed as (`ExpandTo`), read from where the call stands, as rust-analyzer's
 * `ExpandTo::from_call_site`. A call in an item no longer there is read as an expression.
 */
@CalcaTracked
public func expandToOf(db: AnalysisDatabase, call: MacroCallId): ExpandTo {
    if (call.inBody(db).isNone()) {
        return ExpandTo.ToItems
    }
    let syntax = bodyCallSyntaxOf(db, call) ?? return ExpandTo.ToExpr
    if (isStatementPosition(syntax.syntax)) {
        ExpandTo.ToStmts
    } else {
        ExpandTo.ToExpr
    }
}

/**
 * Whether `node` stands where a block's statement does: among the statements of a block, a lambda or an
 * interpolation, or of a `match` case, after its `=>`.
 */
func isStatementPosition(node: CjSyntaxNode): Bool {
    let parent = node.parent ?? return false
    match (parent.kind) {
        case SyntaxKind.Block | SyntaxKind.LambdaExpr | SyntaxKind.Interpolation => true
        case SyntaxKind.MatchCase =>
            match (MatchCase.cast(parent).flatMap { one => one.fatArrowToken() }) {
                case Some(arrow) => arrow.textRange.end <= node.textRange.start
                case None => false
            }
        case _ => false
    }
}

/**
 * The tree of the text of the expansion of `call`, parsed as where the call stands says (`expandToOf`). As `parse`,
 * only the last ones are kept.
 */
@CalcaTracked[lru: 128]
public func expansionParse(db: AnalysisDatabase, call: MacroCallId): CjParse {
    let text = macroExpansion(db, call).text
    match (expandToOf(db, call)) {
        case ToItems => parseText(text)
        case ToExpr => parseExpr(text)
        case ToStmts => parseStmts(text)
    }
}

/**
 * The `ItemIdMap` of the expansion of `call`.
 */
@CalcaTracked
public func expansionIdMap(db: AnalysisDatabase, call: MacroCallId): ItemIdMap {
    ItemIdMap.of(expansionParse(db, call))
}

/**
 * The `ItemTree` of the expansion of `call`.
 */
@CalcaTracked
public func expansionItemTree(db: AnalysisDatabase, call: MacroCallId): ItemTree {
    ItemTree.of(expansionParse(db, call), expansionIdMap(db, call))
}

/**
 * The root of the tree of `file` and the ids of its items: a source file's, an expansion's; `None` for a file of a
 * package compiled already, which has no tree.
 */
public func syntaxOf(db: AnalysisDatabase, file: ItemFile): ?(CjSyntaxNode, ItemIdMap) {
    match (file) {
        case Source(source) => (parse(db, source).syntaxNode(), itemIdMap(db, source))
        case Expansion(call) => (expansionParse(db, call).syntaxNode(), expansionIdMap(db, call))
        case Binary(_, _) => None
    }
}

/**
 * The source file the names of `file` resolve in: itself, the file of the call for an expansion, whose output cjc
 * pastes in the place of the call; `None` for a file of a package compiled already.
 */
public func scopeFileOf(db: AnalysisDatabase, file: ItemFile): ?SourceFile {
    match (file) {
        case Source(source) => source
        case Expansion(call) => call.file(db)
        case Binary(_, _) => None
    }
}

/**
 * Where what declares `item`, an item of the expansion of `call` or a member of one, is written in the call: what it
 * comes from (`ExpansionOrigin`), and around it the call or the declaration; `None` if the call is no longer there.
 */
public func expansionOrigin(
    db: AnalysisDatabase,
    call: MacroCallId,
    item: ItemId
): ?(TextRange, TextRange) {
    let expansion = macroExpansion(db, call)
    if (!expansion.spans.isEmpty()) {
        return mappedOrigin(db, call, item, expansion)
    }
    let items = expansionItemTree(db, call).items
    let declares =
        {
            one: Item =>
            one.id == item || one.members.iterator().any { member => member.id == item }
        }
    let index =
        (items.enumerate() |> filter { pair: (Int64, Item) => declares(pair[1]) } |> first)
            .map { pair: (Int64, Item) => pair[0] } ??
            return None
    let origin = macroExpansion(db, call).origins.get(index) ?? return None
    let file = call.file(db)
    let node = itemIdMap(db, file).node(call.item(db), parse(db, file).syntaxNode()) ?? return None
    let macroCall = macroCallsOf(node).get(call.index(db)) ?? return None
    match (origin) {
        case OfEntry(entry) =>
            let attr = macroCall.macroAttr() ?? return None
            let one = deriveEntries(attr).get(entry) ?? return None
            (one.nameRange, attr.syntax.textRange)
        case OfMacro =>
            let names =
                macroCall.nameRefs() |> map { name => name.syntax.textRange } |> collectArray
            let last = names.get(names.size - 1) ?? return None
            let start = macroCall.atToken()?.textRange.start ?? names[0].start
            let end = macroCall.macroAttr()?.syntax.textRange.end ?? last.end
            (TextRange(names[0].start, last.end), TextRange(start, end))
        case OfName =>
            let name = AnyHasName.cast(node).flatMap { it => it.name() } ?? return None
            (name.syntax.textRange, node.textRange)
        case OfOption =>
            let args = macroCall.macroArgs() ?? return None
            let token = optionNameOf(args)?[0] ?? return None
            (token.textRange, args.syntax.textRange)
    }
}

/**
 * Where the name of `item`, of the expansion of `call` by the macro server, comes from: the source it was copied from,
 * or the head of the call (`macroHeadOf`) for a name the macro wrote; and around it the top-level item the call is
 * under.
 */
func mappedOrigin(
    db: AnalysisDatabase,
    call: MacroCallId,
    item: ItemId,
    expansion: Expansion
): ?(TextRange, TextRange) {
    let expanded =
        expansionIdMap(db, call).node(item, expansionParse(db, call).syntaxNode()) ?? return None
    let name = AnyHasName.cast(expanded).flatMap { it => it.name() } ?? return None
    let file = call.file(db)
    let root = parse(db, file).syntaxNode()
    let ids = itemIdMap(db, file)
    let top =
        (serverCalls(db, file).iterator().filter { one => one.call == call }.next() ?? return None)
            .top
    let anchor = anchorOf(ids, root, top) ?? return None
    let topNode = ids.node(top, root) ?? return None
    let full = (macroCallsOf(topNode).get(0)?.syntax ?? topNode).textRange
    match (MappedText(expansion.text, expansion.spans).originOf(name.syntax.textRange)) {
        case Some(FromSource(range)) => (TextRange(range.start + anchor, range.end + anchor), full)
        case Some(FromCall) =>
            let node = ids.node(call.item(db), root) ?? return None
            let macroCall = macroCallAt(node, call.index(db)) ?? return None
            (macroHeadOf(macroCall), full)
        case None => None
    }
}

/**
 * The macro calls on the item of `node`, outermost first: those around its declaration; for a call on no
 * declaration, those around it, then itself.
 */
func macroCallsOf(node: CjSyntaxNode): Array<MacroExpandDecl> {
    let calls = ArrayList<MacroExpandDecl>()
    if (let Some(call) <- MacroExpandDecl.cast(node)) {
        calls.add(call)
    }
    var parent = node.parent
    while (true) {
        let one = parent ?? break
        let call = MacroExpandDecl.cast(one) ?? break
        calls.add(call)
        parent = one.parent
    }
    calls.reverse()
    calls.toArray()
}

/**
 * The macro calls on each parameter of the item of `node` that has any, in the parameters' order, each outermost
 * first (D119): `@M let x` of a primary constructor, in the parameter lists of the declaration itself, not of a
 * lambda in its body.
 */
func paramMacroCallsOf(node: CjSyntaxNode): Array<Array<MacroExpandDecl>> {
    let chains = ArrayList<Array<MacroExpandDecl>>()
    for (list in node.children() where list.kind == SyntaxKind.ParamList) {
        for (child in list.children()) {
            var call = MacroExpandDecl.cast(child) ?? continue
            let chain = ArrayList<MacroExpandDecl>([call])
            while (let Some(Decl.AsMacroExpandDecl(inner)) <- call.decl()) {
                chain.add(inner)
                call = inner
            }
            chains.add(chain.toArray())
        }
    }
    chains.toArray()
}

/**
 * A chain of macro calls of an item (D119): the calls, outermost first, and the index of its first among the item's
 * (`macroCallChainsOf`).
 */
struct MacroCallChain {
    MacroCallChain(let calls: Array<MacroExpandDecl>, let base: Int64, let onItem: Bool) {}
}

/**
 * The macro calls of the item of `node` by index (D119): those on it (`macroCallsOf`), then those on each parameter of
 * its own parameter lists that has any (`paramMacroCallsOf`), chain after chain. The first chain is the item's own, empty
 * when it has none.
 */
func macroCallChainsOf(node: CjSyntaxNode): Array<MacroCallChain> {
    let own = macroCallsOf(node)
    let chains = ArrayList<MacroCallChain>([MacroCallChain(own, 0, true)])
    var base = own.size
    for (chain in paramMacroCallsOf(node)) {
        chains.add(MacroCallChain(chain, base, false))
        base += chain.size
    }
    chains.toArray()
}

/**
 * How many macro calls the item of `node` has, on it and on its parameters (D119).
 */
func macroCallCountOf(node: CjSyntaxNode): Int64 {
    // `b` is a root of an error type until #246: `fold(0)` is solved without the pipeline's left (D121)
    macroCallChainsOf(node) |> map { chain: MacroCallChain => chain.calls.size } |>
        fold(0) { a, b => a + b }
}

/**
 * The chain of the macro call at `index` of the item of `node`, and the call's position in it (D119).
 */
func macroCallChainAt(node: CjSyntaxNode, index: Int64): ?(MacroCallChain, Int64) {
    for (
        chain in macroCallChainsOf(node) where index >= chain.base &&
            index < chain.base + chain.calls.size
    ) {
        return (chain, index - chain.base)
    }
    None
}

/**
 * The macro call at `index` of the item of `node` (D119).
 */
func macroCallAt(node: CjSyntaxNode, index: Int64): ?MacroExpandDecl {
    macroCallChainAt(node, index).map { found => found[0].calls[found[1]] }
}

/**
 * The index among the macro calls of the item of `node` of `call`, one of them (D119).
 */
func macroCallIndexOf(node: CjSyntaxNode, call: MacroExpandDecl): ?Int64 {
    for (chain in macroCallChainsOf(node)) {
        if (
            let Some(i) <- chain
                .calls
                .map { one => one.syntax.textRange }
                .indexOf(call.syntax.textRange)
        ) {
            return chain.base + i
        }
    }
    None
}
