package fbs_codegen

import std.fs.*
import std.process.*

struct GeneratedFile {
    GeneratedFile(let path: Path, let contents: String) {}
}

/**
 * The views the config at `path` makes of its schema, where they belong, before `cjfmt` has had them.
 */
func generate(path: Path): GeneratedFile {
    let inputs = Inputs.load(path)
    let header = "// Generated by `fbs_codegen` from `${inputs.config.schema}`, as `${path.fileName}` says: do not edit."
    GeneratedFile(
        inputs.dir.join(inputs.config.output),
        emitViews(Names(inputs.schema, inputs.config), header, inputs.config.packageName)
    )
}

/**
 * Writes `contents` to `path` as `cjfmt` formats it: what is checked in is exactly what is generated.
 *
 * @throws IllegalStateException - if `cjfmt` fails, which it does on code that does not parse
 */
func writeFormatted(path: Path, contents: String): Unit {
    let dir = path.parent
    if (!dir.isEmpty() && !exists(dir)) {
        Directory.create(dir, recursive: true)
    }
    File.writeTo(path, contents.toArray())
    let status = execute("cjfmt", ["-f", path.toString(), "-o", path.toString()], stdOut: Discard, stdErr: Discard)
    if (status != 0) {
        throw IllegalStateException("cjfmt failed on ${path}")
    }
}
