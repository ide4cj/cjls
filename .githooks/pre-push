#!/bin/sh
set -e

# cjc behind CI's shim: cjpm's concurrent launches of cjc leak pipes into each other and can
# wait on each other for good (#342); Windows looks for cjc.exe, not the shim
export PATH="$(pwd)/.github/actions/setup-cangjie/shim:$PATH"

# Product sources; negative oracle fixtures keep intentional syntax and layout.
target/release/bin/cjls fmt --check build.cj modules

python3 tests/corpora/fetch.py
# a directory of its own: tests and builds sharing one undo each other's incremental cache (D27)
cjpm test --target-dir target/test
